{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luaturtleweb",
  "compatibility_date": "2026-05-11",
  // Only ./public is published. Repo docs, wrangler config, .git and .wrangler
  // live outside it and are unpublishable by construction — do not point this
  // back at the repo root.
  "assets": {
    "directory": "./public"
  },
  // Both hostnames are served by this Worker; Cloudflare creates their DNS
  // records on deploy. www is redirected to the apex by a zone Redirect Rule.
  "routes": [
    { "pattern": "luaturtle.com", "custom_domain": true },
    { "pattern": "www.luaturtle.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
